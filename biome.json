{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"files": {
		"includes": ["**", "!dist/", "!node_modules/"]
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "asNeeded",
			"trailingCommas": "all"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUndeclaredDependencies": "error"
			},
			"performance": {
				"noDelete": "warn"
			},
			"suspicious": {
				"noFocusedTests": "off"
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noMisusedPromises": "error"
			},
			"complexity": {
				"noBannedTypes": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/**/*.test.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noEmptyBlockStatements": "off"
					}
				}
			}
		}
	]
}
